{
  "name": "rocketc",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Front End Toolkit",
  "keywords": [
    "frontend",
    "react",
    "toolkit",
    "ui components"
  ],
  "license": "MIT",
  "author": "chenfq95 <chenfq95@foxmail.com>",
  "repository": {
    "type": "git",
