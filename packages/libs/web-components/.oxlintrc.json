{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "require-to-throw-message": "off"
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": []
}
