---
import type { ComponentPage } from '../lib/catalog';
import { bilingualCategory, bilingualComponent } from '../lib/bilingual';
import { formatAndHighlightHtml } from '../lib/highlight';

type Props = {
  page: ComponentPage;
};

const { page } = Astro.props;
const demos = await Promise.all(
  page.demos.map(async (demo) => ({
    id: demo.id,
    title: demo.title,
    description: demo.description,
    html: demo.html,
    highlightedCode: await formatAndHighlightHtml(demo.html),
  })),
);
---

<rc-stack gap="lg">
  <rc-stack gap="xs">
    <rc-stack direction="horizontal" gap="sm" align="center" wrap>
      <rc-typography variant="title" as="h1">{bilingualComponent(page.component)}</rc-typography>
      <rc-badge variant="outline">{bilingualCategory(page.category)}</rc-badge>
    </rc-stack>
    <rc-stack direction="horizontal" gap="xs" wrap>
      {
        page.tags.map((tag) => (
          <rc-typography variant="code">{tag}</rc-typography>
        ))
      }
    </rc-stack>
  </rc-stack>

  <rc-stack gap="md">
    {
      demos.map((demo) => (
        <rc-panel class="example-panel" data-demo-id={demo.id} bordered padded>
          <rc-stack slot="header" class="example-panel-header" gap="sm">
            <rc-stack direction="horizontal" gap="md" align="center" justify="between" wrap>
              <rc-typography variant="subheading" as="h2">{demo.title}</rc-typography>
              <rc-segment
                class="example-view-toggle"
                value="preview"
                size="sm"
                aria-label={`${demo.title} 示例视图 / Example view`}
              >
                <rc-segment-item value="preview">预览 / Preview</rc-segment-item>
                <rc-segment-item value="code">代码 / Code</rc-segment-item>
              </rc-segment>
            </rc-stack>
            <rc-typography variant="body-small" color="secondary" as="p">
              {demo.description}
            </rc-typography>
          </rc-stack>

          <div class="example-view is-active" data-example-view="preview">
            <div class="rc-demo-host" set:html={demo.html} />
          </div>
          <div
            class="example-view example-code"
            data-example-view="code"
            hidden
            set:html={demo.highlightedCode}
          />
        </rc-panel>
      ))
    }
  </rc-stack>

  <rc-stack gap="md">
    <rc-stack direction="horizontal" gap="md" align="center" justify="between" wrap>
      <rc-typography variant="heading" as="h2">API 参考 / API Reference</rc-typography>
      <a class="site-inline-link" href="/guides/host-styles/">
        通用宿主样式 / Common Host Styles
      </a>
    </rc-stack>

    {
      page.elements.length === 0 ? (
        <rc-typography variant="body" color="secondary" as="p">
          此目录未找到元素元数据。 / No element metadata found for this folder.
        </rc-typography>
      ) : (
        page.elements.map((element) => (
          <rc-panel bordered padded>
            <rc-stack slot="header" gap="xs">
              <rc-stack direction="horizontal" gap="sm" align="center" wrap>
                <rc-typography variant="subheading" as="h3">
                  {element.tag}
                </rc-typography>
                <rc-badge variant="secondary">{element.file}</rc-badge>
              </rc-stack>
              {element.summary ? (
                <rc-typography variant="body-small" color="secondary" as="p">
                  {element.summary}
                </rc-typography>
              ) : null}
            </rc-stack>

            <rc-stack gap="md">
              {element.props.length > 0 ? (
                <rc-stack gap="sm">
                  <rc-typography variant="label" color="muted" as="p">
                    属性 / Properties
                  </rc-typography>
                  <div class="api-table-wrap">
                    <table class="api-table">
                      <thead>
                        <tr>
                          <th>名称 / Name</th>
                          <th>类型 / Type</th>
                          <th>特性 / Attribute</th>
                          <th>默认值 / Default</th>
                        </tr>
                      </thead>
                      <tbody>
                        {element.props.map((prop) => (
                          <tr>
                            <td>
                              <code>{prop.name}</code>
                            </td>
                            <td>
                              <code>{prop.type}</code>
                            </td>
                            <td>
                              {prop.attribute ? <code>{prop.attribute}</code> : '—'}
                            </td>
                            <td>
                              <code>{prop.defaultValue}</code>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </rc-stack>
              ) : null}

              {element.slots.length > 0 ? (
                <rc-stack gap="sm">
                  <rc-typography variant="label" color="muted" as="p">
                    插槽 / Slots
                  </rc-typography>
                  <div class="api-table-wrap">
                    <table class="api-table">
                      <thead>
                        <tr>
                          <th>名称 / Name</th>
                          <th>说明 / Description</th>
                        </tr>
                      </thead>
                      <tbody>
                        {element.slots.map((slot) => (
                          <tr>
                            <td>
                              <code>{slot.name}</code>
                            </td>
                            <td>{slot.description || '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </rc-stack>
              ) : null}

              {element.events.length > 0 ? (
                <rc-stack gap="sm">
                  <rc-typography variant="label" color="muted" as="p">
                    事件 / Events
                  </rc-typography>
                  <div class="api-table-wrap">
                    <table class="api-table">
                      <thead>
                        <tr>
                          <th>名称 / Name</th>
                          <th>说明 / Description</th>
                        </tr>
                      </thead>
                      <tbody>
                        {element.events.map((event) => (
                          <tr>
                            <td>
                              <code>{event.name}</code>
                            </td>
                            <td>{event.description || '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </rc-stack>
              ) : null}

              {element.parts.length > 0 ? (
                <rc-stack gap="sm">
                  <rc-typography variant="label" color="muted" as="p">
                    CSS 部件 / CSS Parts
                  </rc-typography>
                  <div class="api-table-wrap">
                    <table class="api-table">
                      <thead>
                        <tr>
                          <th>名称 / Name</th>
                          <th>说明 / Description</th>
                        </tr>
                      </thead>
                      <tbody>
                        {element.parts.map((part) => (
                          <tr>
                            <td><code>{part.name}</code></td>
                            <td>{part.description}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </rc-stack>
              ) : null}
            </rc-stack>
          </rc-panel>
        ))
      )
    }
  </rc-stack>
</rc-stack>

<script>
  function bindExampleToggles() {
    document.querySelectorAll('.example-panel').forEach((panel) => {
      if (!(panel instanceof HTMLElement) || panel.dataset.bound === '1') return;
      const toggle = panel.querySelector('.example-view-toggle');
      if (!toggle) return;
      panel.dataset.bound = '1';

      const setView = (view: string) => {
        panel.querySelectorAll<HTMLElement>('[data-example-view]').forEach((section) => {
          const active = section.dataset.exampleView === view;
          section.classList.toggle('is-active', active);
          section.hidden = !active;
        });
      };

      toggle.addEventListener('change', (event) => {
        if (event.target !== toggle) return;
        const value = (event as CustomEvent<{ value?: string }>).detail?.value;
        if (value) setView(value);
      });
    });
  }

  customElements.whenDefined('rc-segment').then(bindExampleToggles);
  document.addEventListener('astro:page-load', bindExampleToggles);
  bindExampleToggles();
</script>
