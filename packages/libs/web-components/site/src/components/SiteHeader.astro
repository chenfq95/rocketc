---
---

<header class="site-header" transition:persist="site-header">
  <rc-stack
    class="site-header-inner"
    direction="horizontal"
    gap="md"
    align="center"
    justify="between"
    wrap
  >
    <rc-stack direction="horizontal" gap="sm" align="center">
      <rc-typography variant="subheading" as="p">Rocketc</rc-typography>
      <rc-badge variant="secondary">web-components</rc-badge>
    </rc-stack>

    <rc-stack
      class="site-header-controls"
      direction="horizontal"
      gap="md"
      align="center"
      aria-label="主题控件 / Theme controls"
    >
      <rc-segment id="theme-family" value="default" size="sm" aria-label="主题系列 / Theme family">
        <rc-segment-item value="default">默认 / Default</rc-segment-item>
        <rc-segment-item value="sun">阳光 / Sun</rc-segment-item>
      </rc-segment>

      <rc-stack direction="horizontal" gap="sm" align="center">
        <rc-label for="theme-dark">深色 / Dark</rc-label>
        <rc-switch id="theme-dark" aria-label="深色模式 / Dark mode"></rc-switch>
      </rc-stack>
    </rc-stack>
  </rc-stack>
</header>
