---
import { getNav } from '../lib/catalog';
import { bilingualCategory, bilingualComponent } from '../lib/bilingual';
import { guidePages } from '../lib/guides';

type Props = {
  activeHref?: string;
};

const { activeHref = '' } = Astro.props;
const nav = getNav();

function isActive(href: string) {
  const normalize = (value: string) => value.replace(/\/+$/, '') || '/';
  const current = normalize(activeHref);
  const target = normalize(href);
  return current === target || current.startsWith(`${target}/`);
}
---

<rc-sidebar class="site-sidebar">
  <rc-scroll-area class="site-nav-scroll" max-height="calc(100vh - 5.5rem)">
    <nav class="site-nav" aria-label="组件 / Components">
      <rc-stack gap="lg">
        <rc-stack gap="sm">
          <rc-typography class="site-nav-label" variant="caption" color="muted" as="p">
            指南 / Guides
          </rc-typography>
          <rc-stack gap="none">
            {
              guidePages.map((page) => {
                const active = isActive(page.href);
                return (
                  <a
                    class:list={['site-nav-link', { 'is-active': active }]}
                    href={page.href}
                    aria-current={active ? 'page' : undefined}
                  >
                    {page.title}
                  </a>
                );
              })
            }
          </rc-stack>
        </rc-stack>
        {
          nav.map((category) => (
            <rc-stack gap="sm">
              <rc-typography class="site-nav-label" variant="caption" color="muted" as="p">
                {bilingualCategory(category.category)}
              </rc-typography>
              <rc-stack gap="none">
                {category.components.map((component) => {
                  const active = isActive(component.href);
                  return (
                    <a
                      class:list={['site-nav-link', { 'is-active': active }]}
                      href={component.href}
                      aria-current={active ? 'page' : undefined}
                    >
                      {bilingualComponent(component.component)}
                    </a>
                  );
                })}
              </rc-stack>
            </rc-stack>
          ))
        }
      </rc-stack>
    </nav>
  </rc-scroll-area>
</rc-sidebar>
