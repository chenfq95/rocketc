---
import { getNav } from '../lib/catalog';

type Props = {
  activeHref?: string;
};

const { activeHref = '' } = Astro.props;
const nav = getNav();

function isActive(href: string) {
  const normalize = (value: string) => value.replace(/\/+$/, '') || '/';
  const current = normalize(activeHref);
  const target = normalize(href);
  return current === target || current.startsWith(`${target}/`);
}
---

<rds-sidebar class="site-sidebar">
  <rds-scroll-area class="site-nav-scroll" max-height="calc(100vh - 5.5rem)">
    <nav class="site-nav" aria-label="Components">
      <rds-stack gap="lg">
        {
          nav.map((category) => (
            <rds-stack gap="sm">
              <rds-typography class="site-nav-label" variant="caption" color="muted" as="p">
                {category.category}
              </rds-typography>
              <rds-stack gap="none">
                {category.components.map((component) => {
                  const active = isActive(component.href);
                  return (
                    <a
                      class:list={['site-nav-link', { 'is-active': active }]}
                      href={component.href}
                      aria-current={active ? 'page' : undefined}
                    >
                      {component.component}
                    </a>
                  );
                })}
              </rds-stack>
            </rds-stack>
          ))
        }
      </rds-stack>
    </nav>
  </rds-scroll-area>
</rds-sidebar>
