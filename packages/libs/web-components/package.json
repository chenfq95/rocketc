{
  "name": "@rocketc/web-components",
  "version": "0.0.1",
  "description": "Web Components built on Rocketc Design System tokens.",
  "keywords": [
    "design-system",
    "lit",
    "web-components"
  ],
  "license": "MIT",
  "author": "chenfq95 <chenfq95@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenfq95/rocketc.git",
    "directory": "packages/libs/web-components"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./min": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.min.js",
      "default": "./dist/index.min.js"
    }
  },
  "scripts": {
    "build": "vite build && bun run build:min",
    "build:min": "vite build --mode min",
    "build:watch": "vite build --watch",
    "dev:site": "bun run build && bun run --filter @rocketc/web-components-site dev",
    "build:site": "bun run build && bun run --filter @rocketc/web-components-site build",
    "preview:site": "bun run --filter @rocketc/web-components-site preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --project tsconfig.lib.json --pretty false"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.0",
    "@lit/context": "^1.1.6",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@rocketc/design-system": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.10.4",
    "@vitest/browser-playwright": "4.1.10",
    "happy-dom": "^20.0.11",
    "oxfmt": "^0.23.0",
    "oxlint": "^1.36.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^8.1.5",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@rocketc/design-system": ">=0.0.1"
  },
  "lint-staged": {
    "**/*.(json|css|scss|md)": [
      "bun run format"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "bun run format",
      "bun run lint:fix"
    ]
  }
}
