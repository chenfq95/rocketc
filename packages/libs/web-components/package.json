{
  "name": "@rocketc/web-components",
  "version": "0.0.1",
  "description": "Web Components built on Rocketc Design System tokens.",
  "keywords": [
    "design-system",
    "lit",
    "web-components"
  ],
  "license": "MIT",
  "author": "chenfq95 <chenfq95@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenfq95/rocketc.git",
    "directory": "packages/libs/web-components"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/register.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@rocketc/design-system": "workspace:*",
    "@types/node": "^24.10.4",
    "oxfmt": "^0.23.0",
    "oxlint": "^1.36.0",
    "typescript": "^5.9.3",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "@rocketc/design-system": ">=0.0.1"
  },
  "lint-staged": {
    "**/*.(json|css|scss|md)": [
      "bun run format"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "bun run format",
      "bun run lint:fix"
    ]
  }
}
