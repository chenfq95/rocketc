{
  "name": "@rocketc/design-system",
  "version": "0.0.1",
  "description": "Framework-agnostic design tokens, compiled assets, and previews for Rocketc.",
  "keywords": [
    "css-variables",
    "design-system",
    "design-tokens",
    "framework-agnostic"
  ],
  "license": "MIT",
  "author": "chenfq95 <chenfq95@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenfq95/rocketc.git",
    "directory": "packages/libs/design-system"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./css/default.dark.css": "./dist/css/default.dark.css",
    "./css/default.light.css": "./dist/css/default.light.css",
    "./css/sun.dark.css": "./dist/css/sun.dark.css",
    "./css/sun.light.css": "./dist/css/sun.light.css",
    "./js": {
      "types": "./dist/js/index.d.ts",
      "import": "./dist/js/index.js"
    },
    "./js/default.dark": {
      "types": "./dist/js/default.dark.d.ts",
      "import": "./dist/js/default.dark.js"
    },
    "./js/default.light": {
      "types": "./dist/js/default.light.d.ts",
      "import": "./dist/js/default.light.js"
    },
    "./js/sun.dark": {
      "types": "./dist/js/sun.dark.d.ts",
      "import": "./dist/js/sun.dark.js"
    },
    "./js/sun.light": {
      "types": "./dist/js/sun.light.d.ts",
      "import": "./dist/js/sun.light.js"
    },
    "./mui": {
      "types": "./dist/mui/index.d.ts",
      "import": "./dist/mui/index.js"
    },
    "./mui/default.dark": {
      "types": "./dist/mui/default.dark.d.ts",
      "import": "./dist/mui/default.dark.js"
    },
    "./mui/default.light": {
      "types": "./dist/mui/default.light.d.ts",
      "import": "./dist/mui/default.light.js"
    },
    "./mui/sun.dark": {
      "types": "./dist/mui/sun.dark.d.ts",
      "import": "./dist/mui/sun.dark.js"
    },
    "./mui/sun.light": {
      "types": "./dist/mui/sun.light.d.ts",
      "import": "./dist/mui/sun.light.js"
    },
    "./chakra/default.dark": {
      "types": "./dist/chakra/default.dark.d.ts",
      "import": "./dist/chakra/default.dark.js"
    },
    "./chakra/default.light": {
      "types": "./dist/chakra/default.light.d.ts",
      "import": "./dist/chakra/default.light.js"
    },
    "./chakra/sun.dark": {
      "types": "./dist/chakra/sun.dark.d.ts",
      "import": "./dist/chakra/sun.dark.js"
    },
    "./chakra/sun.light": {
      "types": "./dist/chakra/sun.light.d.ts",
      "import": "./dist/chakra/sun.light.js"
    }
  },
  "scripts": {
    "build": "bun run build:tokens",
    "build:preview": "vite build preview --outDir ../.vite-preview --emptyOutDir",
    "build:tokens": "bun scripts/build-tokens.ts",
    "dev": "vite . --host 0.0.0.0",
    "format": "oxfmt",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.30.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.6",
    "@types/bun": "^1.3.5",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-dictionary": "^5.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.30.0",
    "@mui/material": "^7.3.6"
  },
  "peerDependenciesMeta": {
    "@chakra-ui/react": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    }
  }
}
