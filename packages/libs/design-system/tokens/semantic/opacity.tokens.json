      "$value": "{opacity.40}",
      "$type": "number"
    },
    "hover": {
      "$value": "{opacity.80}",
      "$type": "number"
    },
    "pressed": {
      "$value": "{opacity.90}",
      "$type": "number"
    },
    "muted": {
      "$value": "{opacity.60}",
      "$type": "number"
    },
    "overlay": {
      "$value": "{opacity.50}",
      "$type": "number"
    },
    "scrim": {
