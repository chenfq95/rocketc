{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "layout": {
    "page": {
      "maxWidth": {
        "$value": "{container.xl}",
        "$type": "dimension"
      },
      "gutter": {
        "$value": "{space.4}",
        "$type": "dimension"
      }
    },
    "reading": {
      "maxWidth": {
        "$value": "{layout.readingMaxWidth}",
        "$type": "dimension"
      }
    },
    "header": {
      "height": {
        "$value": "{layout.headerHeight}",
        "$type": "dimension"
      }
    },
    "toolbar": {
      "height": {
        "$value": "{layout.toolbarHeight}",
        "$type": "dimension"
      }
    },
    "sidebar": {
      "width": {
        "$value": "{layout.sidebarWidth}",
        "$type": "dimension"
      },
      "collapsedWidth": {
        "$value": "{layout.sidebarCollapsedWidth}",
        "$type": "dimension"
      }
    },
    "content": {
      "maxWidth": {
        "$value": "{layout.contentMaxWidth}",
        "$type": "dimension"
      }
    }
  }
}
