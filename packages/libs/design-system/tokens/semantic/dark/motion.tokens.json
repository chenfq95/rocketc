{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "motion": {
    "duration": {
      "fast": {
        "$value": "{duration.fast}",
        "$type": "duration"
      },
      "normal": {
        "$value": "{duration.normal}",
        "$type": "duration"
      },
      "slow": {
        "$value": "{duration.slow}",
        "$type": "duration"
      }
    },
    "easing": {
      "standard": {
        "$value": "{easing.standard}",
        "$type": "cubicBezier"
      },
      "enter": {
        "$value": "{easing.enter}",
        "$type": "cubicBezier"
      },
      "exit": {
        "$value": "{easing.exit}",
        "$type": "cubicBezier"
      }
    }
  }
}
