{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "layout": {
    "page": {
      "maxWidth": {
        "$value": "{measure.xl}",
        "$type": "dimension"
      },
      "gutter": {
        "$value": "{space.2}",
        "$type": "dimension"
      }
    },
    "reading": {
      "maxWidth": {
        "$value": {
          "value": 720,
          "unit": "px"
        },
        "$type": "dimension"
      }
    },
    "header": {
      "height": {
        "$value": "{space.11}",
        "$type": "dimension"
      }
    },
    "toolbar": {
      "height": {
        "$value": "{space.8}",
        "$type": "dimension"
      }
    },
    "sidebar": {
      "width": {
        "$value": {
          "value": 248,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "collapsedWidth": {
        "$value": "{space.12}",
        "$type": "dimension"
      }
    },
    "content": {
      "maxWidth": {
        "$value": "{measure.xl}",
        "$type": "dimension"
      }
    }
  }
}
