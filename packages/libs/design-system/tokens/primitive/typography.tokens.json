{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "typography": {
    "family": {
      "sans": {
        "$value": [
          "Noto Sans SC",
          "Source Han Sans SC",
          "PingFang SC",
          "Microsoft YaHei",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": ["Noto Sans Mono", "ui-monospace", "SFMono-Regular", "monospace"],
        "$type": "fontFamily"
      }
    },
    "size": {
      "xs": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "sm": {
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "md": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "lg": {
        "$value": {
          "value": 18,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "xl": {
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "2xl": {
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "3xl": {
        "$value": {
          "value": 30,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "4xl": {
        "$value": {
          "value": 36,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "5xl": {
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "6xl": {
        "$value": {
          "value": 60,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "7xl": {
        "$value": {
          "value": 72,
          "unit": "px"
        },
        "$type": "dimension"
      }
    },
    "weight": {
      "thin": {
        "$value": 100,
        "$type": "fontWeight"
      },
      "extralight": {
        "$value": 200,
        "$type": "fontWeight"
      },
      "light": {
        "$value": 300,
        "$type": "fontWeight"
      },
      "normal": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      },
      "bold": {
        "$value": 700,
        "$type": "fontWeight"
      },
      "extrabold": {
        "$value": 800,
        "$type": "fontWeight"
      },
      "black": {
        "$value": 900,
        "$type": "fontWeight"
      }
    },
    "lineHeight": {
      "none": {
        "$value": 1,
        "$type": "number"
      },
      "tight": {
        "$value": 1.15,
        "$type": "number"
      },
      "snug": {
        "$value": 1.25,
        "$type": "number"
      },
      "normal": {
        "$value": 1.5,
        "$type": "number"
      },
      "relaxed": {
        "$value": 1.625,
        "$type": "number"
      },
      "loose": {
        "$value": 2,
        "$type": "number"
      }
    },
    "letterSpacing": {
      "tighter": {
        "$value": {
          "value": -0.6,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "tight": {
        "$value": {
          "value": -0.3,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "normal": {
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "wide": {
        "$value": {
          "value": 0.3,
          "unit": "px"
        },
        "$type": "dimension"
      },
      "wider": {
        "$value": {
          "value": 0.5,
          "unit": "px"
        },
        "$type": "dimension"
      }
    }
  }
}
