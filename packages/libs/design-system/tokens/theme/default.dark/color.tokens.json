{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "surface": {
      "canvas": { "$value": "{color.black}", "$type": "color" },
      "panel": { "$value": "{color.neutral.950}", "$type": "color" },
