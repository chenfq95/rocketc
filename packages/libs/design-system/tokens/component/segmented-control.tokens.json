{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "segmentedControl": {
    "background": {
      "$value": "{color.surface.panel}",
      "$type": "color"
    },
    "border": {
      "$value": "{color.border.subtle}",
      "$type": "color"
    },
    "itemText": {
      "$value": "{color.text.secondary}",
      "$type": "color"
    },
    "itemSelectedBackground": {
      "$value": "{color.brand.solid}",
      "$type": "color"
    },
    "itemSelectedText": {
      "$value": "{color.text.inverse}",
      "$type": "color"
    },
    "radius": {
      "$value": "{radius.sm}",
      "$type": "dimension"
    },
    "itemRadius": {
      "$value": "{radius.sm}",
      "$type": "dimension"
    },
    "padding": {
      "$value": "{space.1}",
      "$type": "dimension"
    },
    "itemPaddingX": {
      "$value": "{space.2}",
      "$type": "dimension"
    },
    "itemPaddingY": {
      "$value": "{space.1}",
      "$type": "dimension"
    },
    "typography": {
      "$value": "{typography.label}",
      "$type": "typography"
    }
  }
}
