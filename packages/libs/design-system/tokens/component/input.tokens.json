{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "input": {
    "height": {
      "$value": {
        "value": 32,
        "unit": "px"
      },
      "$type": "dimension"
    },
    "paddingX": {
      "$value": "{space.2}",
      "$type": "dimension"
    },
    "paddingY": {
      "$value": "{space.1}",
      "$type": "dimension"
    },
    "background": {
      "$value": "{color.surface.panel}",
      "$type": "color"
    },
    "border": {
      "$value": "{color.border.default}",
      "$type": "color"
    },
    "borderFocus": {
      "$value": "{color.border.focus}",
      "$type": "color"
    },
    "radius": {
      "$value": "{radius.sm}",
      "$type": "dimension"
    }
  }
}
