{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "alert": {
    "padding": {
      "$value": "{space.3}",
      "$type": "dimension"
    },
    "gap": {
      "$value": "{space.1}",
      "$type": "dimension"
    },
    "radius": {
      "$value": "{radius.md}",
      "$type": "dimension"
    },
    "titleTypography": {
      "$value": "{typography.label}",
      "$type": "typography"
    },
    "bodyTypography": {
      "$value": "{typography.caption}",
      "$type": "typography"
    },
    "success": {
      "background": {
        "$value": "{color.state.success.soft}",
        "$type": "color"
      },
      "text": {
        "$value": "{color.state.success.solid}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.state.success.solid}",
        "$type": "color"
      }
    },
    "warning": {
      "background": {
        "$value": "{color.state.warning.soft}",
        "$type": "color"
      },
      "text": {
        "$value": "{color.state.warning.solid}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.state.warning.solid}",
        "$type": "color"
      }
    },
    "danger": {
      "background": {
        "$value": "{color.state.danger.soft}",
        "$type": "color"
      },
      "text": {
        "$value": "{color.state.danger.solid}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.state.danger.solid}",
        "$type": "color"
      }
    },
    "info": {
      "background": {
        "$value": "{color.state.info.soft}",
        "$type": "color"
      },
      "text": {
        "$value": "{color.state.info.solid}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.state.info.solid}",
        "$type": "color"
      }
    }
  }
}
