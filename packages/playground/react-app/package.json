{
  "name": "@rocketc/react-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@rocketc/design-system": "workspace:*",
    "@rocketc/react-use-shortcuts": "workspace:*",
    "@tabler/icons-react": "^3.36.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "2.15.4",
    "wouter": "^3.9.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "oxfmt": "^0.23.0",
    "oxlint": "^1.36.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^6.0.3"
  },
  "lint-staged": {
    "**/*.(json|css|scss|md)": [
      "bun run format"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "bun run format",
      "bun run lint:fix"
    ]
  }
}
